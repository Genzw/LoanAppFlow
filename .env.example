# Reference only: configure each component separately, never copy secrets into a browser bundle.
# Access and adaptive worker are implemented; hosting/TLS verification remains pending.
# Web
APP_PROFILE=CloudDemo
DEMO_ORIGIN=https://your-web.example
BACKEND_BASE_URL=https://your-api.example
DEMO_PASSWORD_HASH=replace-with-generated-verifier
SESSION_SIGNING_KEY=replace-with-32-byte-base64-key
BACKEND_SERVICE_TOKEN=replace-with-32-byte-base64-token
# API (Production)
App__Profile=CloudDemo
ASPNETCORE_ENVIRONMENT=Production
Security__DemoOrigin=https://your-web.example
Security__BackendToken=match-BACKEND_SERVICE_TOKEN
ExternalService__BaseUrl=https://your-mock.example
ExternalService__Token=replace-with-distinct-32-byte-base64-token
Outbox__Enabled=true
ConnectionStrings__AppDb=configure-runtime-database-with-verified-TLS
# Mock (Production, a separate process and database)
Security__IntegrationToken=match-ExternalService__Token
ConnectionStrings__MockDb=configure-separate-runtime-database-with-verified-TLS
